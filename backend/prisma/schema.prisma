generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  paid
  expired
  needs_review
  picked_up

  @@map("order_status")
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  pricePaise Int         @map("price_paise")
  stock      Int
  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  status      OrderStatus @default(pending)
  totalPaise  Int         @map("total_paise")
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  paidAt      DateTime?   @map("paid_at") @db.Timestamptz
  pickedUpAt  DateTime?   @map("picked_up_at") @db.Timestamptz
  items       OrderItem[]

  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  orderId        String  @map("order_id") @db.Uuid
  productId      Int     @map("product_id")
  quantity       Int
  unitPricePaise Int     @map("unit_price_paise")
  order          Order   @relation(fields: [orderId], references: [id])
  product        Product @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
  @@map("order_items")
}

model WebhookEvent {
  eventId    String   @id @map("event_id")
  orderId    String?  @map("order_id") @db.Uuid
  payload    Json
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@map("webhook_events")
}
